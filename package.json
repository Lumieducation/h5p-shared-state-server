{
    "name": "@lumieducation/h5p-shared-state-server",
    "version": "10.0.4",
    "description": "A component providing server-side support for shared states with ShareDB",
    "main": "build/SharedStateServer.js",
    "types": "build/SharedStateServer.d.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/Lumieducation/h5p-shared-state-server"
    },
    "scripts": {
        "build:watch": "npx tsc -w -p ./tsconfig.build.json",
        "build": "tsc -p ./tsconfig.build.json",
        "format:check": "npx prettier --check \"{src,test}/**/*.ts\" \"example/src/**/*.ts\"",
        "format": "npx prettier --write \"{src,test}/**/*.ts\" \"example/src/**/*.ts\"",
        "lint": "eslint .",
        "prepare": "husky",
        "test": "vitest run --config vitest.config.ts",
        "build:example": "npm run build --prefix example",
        "start:example": "npm run start --prefix example",
        "start:example:watch": "npm run start:watch --prefix example",
        "release": "semantic-release"
    },
    "author": "S. Rettig",
    "license": "GPL-3.0",
    "dependencies": {
        "@lumieducation/h5p-server": "^10.0.4",
        "@teamwork/websocket-json-stream": "^2.0.0",
        "ajv": "^8.12.0",
        "debug": "^4.3.4",
        "jsonpath-plus": "^7.2.0",
        "sharedb": "^5.0.0",
        "ws": "^8.13.0"
    },
    "devDependencies": {
        "@commitlint/cli": "19.6.1",
        "@commitlint/config-conventional": "19.6.0",
        "@eslint/js": "^9.17.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@types/sharedb": "5.1.0",
        "@types/ws": "8.18.1",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^15.14.0",
        "husky": "9.1.7",
        "prettier": "3.6.2",
        "semantic-release": "^25.0.9",
        "ts-node": "10.9.2",
        "typedoc": "0.28.20",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.56.0",
        "vitest": "^4.0.18"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "build",
        "CHANGELOG.md",
        "README.md"
    ],
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=9.0.0"
    }
}
